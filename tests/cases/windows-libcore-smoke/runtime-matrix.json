{
  "schema_version": 1,
  "cases": {
    "AbsPathProbe": {
      "expected_markers": [
        "path.separator=;",
        "file.separator=\\",
        "AbsPathProbe.fails=0",
        "AbsPathProbe.done=ok",
        "Hello.load=ok"
      ],
      "mode": "absolute-path",
      "timeout_seconds": 120
    },
    "AsyncCloseProbe": {
      "expected_markers": [
        "accept.blocking",
        "server.closing",
        "accept.unblocked=true alive=false",
        "client.reading",
        "peer.closing",
        "read.unblocked=true alive=false",
        "AsyncCloseProbe.done=ok"
      ],
      "forbidden_markers": [
        "accept.unexpectedPeer=",
        "AsyncCloseProbe.done=fail"
      ],
      "timeout_seconds": 60
    },
    "BnProbe": {
      "expected_markers": [
        "BnProbe.done=ok sum=1111111110111111111011111111100 mod=9000000000900000000090 pow=483792039048379203904837920390"
      ],
      "timeout_seconds": 60
    },
    "CoreProbe": {
      "expected_markers": [
        "arraycopy=true",
        "charset=true",
        "reflect=reflect-ok",
        "threads.ok=true",
        "CoreProbe.done=ok"
      ],
      "timeout_seconds": 120
    },
    "DnsProbe": {
      "expected_markers": [
        "dns.ok=true",
        "payload=dns-ok",
        "DnsProbe.done=ok"
      ],
      "timeout_seconds": 120
    },
    "ExecProbe": {
      "expected_markers": [
        "exec.out=exec.probe.ok",
        "exec.code=0",
        "runtime.out=runtime.exec.ok",
        "runtime.code=0",
        "ExecProbe.done=ok"
      ],
      "forbidden_markers": ["ExecProbe.fail="],
      "timeout_seconds": 120
    },
    "GcForced": {
      "expected_markers": [
        "tiny.ok=true",
        "los.ok=true",
        "gc.forced.ok=true",
        "GcForced.done=ok"
