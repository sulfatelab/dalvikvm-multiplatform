      "timeout_seconds": 300
    },
    "GcProbe": {
      "expected_markers": [
        "los.ok=true",
        "gc.ok=true",
        "GcProbe.done=ok"
      ],
      "timeout_seconds": 180
    },
    "GoldenApp": {
      "expected_markers": [
        "conf.match=true",
        "net.ok=true",
        "interrupt.ok=true",
        "golden.ok=true",
        "GoldenApp.done=ok"
      ],
      "timeout_seconds": 300
    },
    "InterruptProbe": {
      "expected_markers": [
        "alive=false",
